<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MQ Round 2 College Order</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
:root{
  color-scheme:light;
  --bg:#f4f6f5; --surface:#ffffff; --ink:#15232b; --muted:#56666e; --line:#d9e0dd;
  --accent:#17665a; --accent-soft:#e2efeb; --held:#a8671a; --held-soft:#f7ecdc;
  --good:#2f7d4f; --warn:#b5701c; --bad:#b1403a;
  --h1:#e3eeea; --h2:#c6ded6; --h3:#9fc9bb; --h4:#6fae9a; --h5:#3f8f79;
  --serif:"Instrument Serif", Georgia, "Times New Roman", serif;
  --sans:"Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono:"JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.55}
.wrap{max-width:1120px;margin:0 auto;padding-inline:20px;padding-block:12px 64px;display:flex;flex-direction:column;gap:36px}
h1,h2{font-family:var(--serif);font-weight:400;text-wrap:balance;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(34px,5.4vw,56px);line-height:1.02}
h2{font-family:var(--sans);font-size:15px;font-weight:700;line-height:1.3;letter-spacing:0}
h3{font-size:15px;margin:0;font-weight:600}
p{margin:0;max-width:68ch}
.eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.muted{color:var(--muted)}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
header.oneline{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;font-size:13px;padding-bottom:8px;border-bottom:1px solid var(--line);color:var(--muted)}
header.oneline h1{font-family:var(--sans);font-size:13px;font-weight:700;line-height:1.4;color:var(--ink);letter-spacing:0}
header.oneline .dl strong{color:var(--held)}
header.oneline .sep{opacity:.5}
.chip{font-size:13px;padding:5px 10px;border-radius:999px;background:var(--held-soft);border:1px solid var(--held)}
.chip strong{color:var(--held)}
.deadline{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:baseline;padding:14px 16px;border:1px solid var(--held);background:var(--held-soft);border-radius:6px}
.deadline strong{color:var(--held)}
section{display:flex;flex-direction:column;gap:16px}

/* Order list */
.order{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.slot{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px;display:flex;flex-direction:column;gap:8px}
.slot .pos{font-family:var(--mono);font-size:12px;color:var(--accent);font-weight:600}
.slot .name{font-family:var(--sans);font-size:15px;font-weight:700;line-height:1.3}
.slot.skip{border-style:dashed;background:transparent}
.slot.skip .pos{color:var(--bad)}
.slot.held{border-color:var(--held);background:var(--held-soft)}
.slot.held .pos{color:var(--held)}
.slot p{font-size:14px}

/* Leaderboard */
.lenses{display:flex;flex-wrap:wrap;gap:8px}
.lens{font:inherit;font-size:14px;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:8px 14px;border-radius:999px;cursor:pointer}
.lens[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.lens:focus-visible,.toggle:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.board{display:flex;flex-direction:column;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px}
.row{display:grid;grid-template-columns:28px minmax(120px,190px) 1fr 52px;gap:12px;align-items:center}
.row .rk{font-family:var(--mono);color:var(--muted);font-size:13px}
.row .nm{font-weight:600;font-size:14.5px}
.row .nm small{display:block;font-weight:400;color:var(--muted);font-size:12px}
.bar{height:12px;background:var(--h1);border-radius:2px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);transition:width .35s ease}
.row.is-held .bar i{background:var(--held)}
.row .sc{font-family:var(--mono);font-size:14px;text-align:right;font-weight:600}
@media (prefers-reduced-motion:reduce){.bar i{transition:none}}

/* Matrix */
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:900px;font-size:13px}
th,td{padding:10px 10px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}
thead th{position:sticky;top:0;background:var(--surface);font-size:12.5px;font-weight:600;z-index:1}
thead th.held{color:var(--held)}
tbody th{font-weight:600;width:210px}
tbody th .w{display:block;font-family:var(--mono);font-weight:400;font-size:11px;color:var(--muted);margin-top:2px}
td .s{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-weight:600;font-size:13px;padding:2px 7px;border-radius:3px}
td .s b{font-weight:400;font-size:10.5px;opacity:.8}
td .ev{display:block;color:var(--muted);font-size:12px;margin-top:4px;line-height:1.4}
td.best .s{outline:1.5px solid var(--accent)}
tfoot td,tfoot th{font-weight:600;background:var(--accent-soft);border-bottom:0}
.hideev td .ev{display:none}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
.toggle{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:6px 12px;border-radius:4px;cursor:pointer}

/* Profiles */
.profiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.prof{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px;display:flex;flex-direction:column;gap:10px}
.prof h3{font-family:var(--sans);font-weight:700;font-size:15px;line-height:1.3}
.prof dl{display:grid;grid-template-columns:max-content 1fr;gap:4px 12px;margin:0;font-size:13px}
.prof dt{color:var(--muted)}
.prof dd{margin:0}
.pc{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px}
.pc ul{margin:4px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:3px}
.pc .plus{color:var(--good);font-weight:600;font-size:12px}
.pc .minus{color:var(--bad);font-weight:600;font-size:12px}
@media (max-width:520px){.pc{grid-template-columns:1fr}.row{grid-template-columns:22px 1fr 44px}.row .bar{grid-column:2/4;grid-row:2}}

.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px 28px;font-size:14px}
.notes p{max-width:none}
ol.src{margin:0;padding-left:20px;font-size:13px;display:flex;flex-direction:column;gap:4px;color:var(--muted)}
ol.src a{color:var(--accent)}
.legend{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--muted);flex-wrap:wrap}
.legend span.sw{width:18px;height:12px;border-radius:2px;display:inline-block}
table.pr{min-width:760px}
table.pr td{font-size:12.5px;line-height:1.45}
table.pr td b{font-family:var(--mono);font-size:13px}
table.pr td.gap{color:var(--muted);font-style:italic}
th.heldname{color:var(--held)}
.tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
.tag.mid{background:var(--accent-soft);color:var(--accent)}
.tag.low{background:var(--held-soft);color:var(--held)}
.tag.none{background:#f6e3e1;color:var(--bad)}
.why{display:flex;flex-direction:column;gap:8px;font-size:14px}
.why ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;max-width:80ch}
table.fr{min-width:820px}
table.fr td{font-size:12.5px;line-height:1.45}
table.fr td b{font-family:var(--mono)}
table.pr td.new{background:var(--accent-soft)}
.league{display:flex;flex-direction:column;gap:6px}
.lg{list-style:none;margin:0;padding:10px 14px;background:var(--surface);border:1px solid var(--line);border-radius:6px;display:grid;grid-template-columns:1fr 1fr;grid-auto-flow:column;grid-template-rows:repeat(13,auto);column-gap:28px;row-gap:2px;font-size:12.5px}
.lg li{display:grid;grid-template-columns:22px minmax(0,1fr) 90px 50px;gap:8px;align-items:center;padding:2px 4px;border-radius:3px}
.lg .lr{font-family:var(--mono);color:var(--muted);font-size:11px}
.lg .lv{font-family:var(--mono);text-align:right;font-weight:600}
.lg .lb{height:7px;background:var(--h1);border-radius:2px;overflow:hidden}
.lg .lb i{display:block;height:100%;background:#9fb3ad}
.lg li.me{background:var(--accent-soft);font-weight:600}
.lg li.me .lb i{background:var(--accent)}
.lg li.held{background:var(--held-soft);font-weight:600;color:var(--held)}
.lg li.held .lb i{background:var(--held)}
@media (max-width:640px){.lg{grid-template-columns:1fr;grid-auto-flow:row;grid-template-rows:none}}
</style></head><body>

<div class="wrap">

<header class="oneline">
  <h1>MQ Round 2: 5 colleges ranked</h1><span class="sep">·</span>
